# Copy to nexus-python/.env. Keep real credentials out of Git.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nexusai
DB_USERNAME=root
DB_PASSWORD=replace-with-your-local-database-password
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Both Java/Gateway and Python must use the same JWT secret (32+ bytes).
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Optional OpenAI-compatible chat service. No key is needed for basic collection.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=your-chat-model

# Optional MCP child processes; default transport is bounded HTTP/RSS.
MCP_ENABLED=false
# Test-only. Keep false in normal use.
NEXUS_ALLOW_LOCAL_SOURCES=false
# Automatic RSS source health checks (paced, without subscriptions or pushes).
SOURCE_HEALTH_ENABLED=true
NEXUS_ENV=development
LOG_LEVEL=INFO
